# MAHAD - optional free data-API keys.
# Copy this file to .env (git-ignored - NEVER commit .env) and fill in the
# values. All three are free, email-only signups; none can trade or move
# money. MAHAD launches fully without any key: crypto (Kraken), FX
# (Frankfurter), US Treasury yields, Bank of England rates, Fear & Greed,
# and simulated trading on crypto pairs all run keyless; stock surfaces show a
# clear "needs a free key" state until the keys below are set. MAHAD holds
# no broker, banking, trading, or payment credentials, ever.

FINNHUB_API_KEY=   # free key: finnhub.io/register (email only) - live stock quotes
TIINGO_API_KEY=    # free key: tiingo.com signup (email only) - stock history, dividends, splits
FRED_API_KEY=      # free key: fred.stlouisfed.org (existing) - the VIX tile

# Keyless sources (nothing to configure): Kraken public market data,
# Frankfurter (ECB reference FX rates), US Treasury daily par yield curve
# (also the Sharpe risk-free input), Bank of England IADB (SONIA + Bank
# Rate), alternative.me Fear & Greed.
